{
  "name": "engineering-mastery-lab",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run validate:academy-formulas && node scripts/build-academy-offline-manifest.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && playwright test --project=functional --project=cad-recovery --project=routes",
    "test:visual-review": "npm run build && playwright test --project=visual-review --grep @visual-review",
    "validate:academy-media": "node --experimental-strip-types scripts/validate-academy-media.mjs",
    "validate:academy-playback:chromium": "node scripts/validate-academy-playback-chromium.mjs",
    "validate:academy-playback:webview2": "node scripts/validate-academy-playback-chromium.mjs --runtime=webview2",
    "validate:academy-sources": "node scripts/validate-academy-sources.mjs",
    "validate:academy-formulas": "node scripts/validate-academy-formulas.mjs",
    "build:tauri-frontend": "npm run build",
    "tauri": "tauri",
    "build:desktop": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "katex": "0.18.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
